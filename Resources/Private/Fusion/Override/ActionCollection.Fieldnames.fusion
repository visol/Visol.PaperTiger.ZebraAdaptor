# Backend-only: lists the form's field placeholders above the action collection
# so editors can copy them into the e-mail body.
prototype(Sitegeist.PaperTiger:ActionCollection.Fieldnames) < prototype(Neos.Fusion:Component) {
    nodePath = null
    title = ${Translation.translate('actionCollection.fieldNames.description', 'Field names:', [], 'Main', 'Sitegeist.PaperTiger')}
    description = ${Translation.translate('actionCollection.fieldNames.copyToClipboard', 'Copy to clipboard', [], 'Main', 'Sitegeist.PaperTiger')}

    @context {
        // don't show buttons for selectd NodeTypes
        omitNodeTypes= Neos.Fusion:DataStructure {
            button = 'Sitegeist.PaperTiger:Field.Button'
            honeypot = 'Sitegeist.PaperTiger:Field.Honeypot'
        }
    }

    items = ${q(node).children(props.nodePath).find('[instanceof Sitegeist.PaperTiger:Field]').get()}

    @if.hasNodePathAndItems = ${this.nodePath && Type.isArray(this.items) && Array.length(this.items)}

    renderer >
    renderer = afx`
        <div class="papertiger-fieldnames">
            <div class="papertiger-fields">
                    <span @key="text" class="papertiger-fieldnames__text">
                        {'{allFormValues}'}
                    </span>
                <button @key="button"  type="button" class="papertiger-fieldnames__button">
                    {'{allFormValues}'}
                </button>

                <Neos.Fusion:Loop @key="fieldNames" items={props.items}>
                    <span @key="text" class="papertiger-fieldnames__text" @if={Array.indexOf(omitNodeTypes, item.nodeType.name) == -1}>
                        {'{' + item.properties.name + '}'}
                    </span>
                    <button @key="button"  type="button" class="papertiger-fieldnames__button" @if={Array.indexOf(omitNodeTypes, item.nodeType.name) == -1}>
                        {'{' + item.properties.name + '}'}
                    </button>
                </Neos.Fusion:Loop>
            </div>
            <span @if={props.description} @key="description" class="papertiger-fieldnames__description">
             {Translation.translate('actionCollection.fieldNames.hint', 'Click a field placeholder to copy it to the clipboard, then paste it into the e-mail content.', [], 'Main', 'Visol.PaperTiger.ZebraAdaptor')}
            </span>
        </div>
    `
}
