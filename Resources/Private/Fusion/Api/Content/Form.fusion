prototype(Networkteam.Neos.ContentApi:BaseNode) {
  form = Neos.Fusion:DataStructure {
    method = 'post'
    validationSchema = Visol.PaperTiger.ZebraAdaptor:ValidationSchema {
      formIdentifier = ${q(node).property('_identifier')}
      fields = ${q(node).find('[instanceof Sitegeist.PaperTiger:Field]').get()}
    }
    triggerSchema = Visol.PaperTiger.ZebraAdaptor:TriggerSchema {
      formIdentifier = ${q(node).property('_identifier')}
      fields = ${q(node).find('[instanceof Sitegeist.PaperTiger:Field]').get()}
    }
    thresholdSchema = Visol.PaperTiger.ZebraAdaptor:ThresholdSchema {
      formIdentifier = ${q(node).property('_identifier')}
      fields = ${q(node).find('[instanceof Sitegeist.PaperTiger:Field]').get()}
    }
    formIdentifierWithHmac = ${Visol.PaperTiger.ZebraAdaptor.appendHmac(q(node).property('_identifier'))}
    hasActions = ${q(node).children('actions').children().is()}
  }
  form.@if.isForm = ${Neos.Node.isOfType(node, 'Sitegeist.PaperTiger:Form')}
}
